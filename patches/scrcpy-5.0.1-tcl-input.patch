+++ b/server/src/main/java/com/genymobile/scrcpy/control/TvButtonController.java
@@ -0,0 +1,164 @@
+package com.genymobile.scrcpy.control;
+
+import com.genymobile.scrcpy.model.Point;
+import com.genymobile.scrcpy.device.Device;
+import com.genymobile.scrcpy.util.Ln;
+
+import android.app.UiAutomation;
+import android.graphics.Rect;
+import android.os.HandlerThread;
+import android.os.Handler;
+import android.os.SystemClock;
+import android.view.KeyEvent;
+import android.os.Looper;
+import android.view.MotionEvent;
+import android.view.accessibility.AccessibilityNodeInfo;
+
+/** Route the TCL desktop through its button actions and native scrolling animations. */
+final class TvButtonController {
+    private UiAutomation automation;
+    private HandlerThread thread;
+    private AccessibilityNodeInfo button;
+    private boolean consuming;
+    private boolean dragged;
+    private Point down;
+    private Handler wheelHandler;
+    private boolean wheelDesktop;
+    private long lastWheelEvent;
+    private long lastWheelKey;
+    private float wheelAmount;
+    private int wheelKey;
+    private int wheelRepeat;
+    private final Runnable wheelRelease = this::stopWheel;
+
+    private UiAutomation automation() {
+        if (automation == null) {
+            thread = new HandlerThread("tv-buttons");
+            thread.start();
+            wheelHandler = new Handler(thread.getLooper());
+            try {
+                Object connection = Class.forName("android.app.UiAutomationConnection").getConstructor().newInstance();
+                automation = (UiAutomation) UiAutomation.class
+                        .getConstructor(Looper.class, Class.forName("android.app.IUiAutomationConnection"))
+                        .newInstance(thread.getLooper(), connection);
+                // Keep any owner-enabled accessibility services running.
+                UiAutomation.class.getMethod("connect", int.class).invoke(automation, 1);
+            } catch (ReflectiveOperationException e) {
+                throw new IllegalStateException("Cannot connect TV button controller", e);
+            }
+        }
+        return automation;
+    }
+
+    private static AccessibilityNodeInfo findButton(AccessibilityNodeInfo node, Point point) {
+        Rect bounds = new Rect();
+        node.getBoundsInScreen(bounds);
+        if (!node.isVisibleToUser() || !bounds.contains(point.getX(), point.getY())) {
+            return null;
+        }
+        for (int i = 0; i < node.getChildCount(); ++i) {
+            AccessibilityNodeInfo child = node.getChild(i);
+            if (child != null) {
+                AccessibilityNodeInfo result = findButton(child, point);
+                if (result != null) {
+                    return result;
+                }
+            }
+        }
+        return node.isClickable() && node.isEnabled() ? node : null;
+    }
+
+    boolean touch(int action, Point point) {
+        if (action == MotionEvent.ACTION_DOWN) {
+            stopWheel();
+            AccessibilityNodeInfo root = automation().getRootInActiveWindow();
+            consuming = root != null && "com.tcl.cyberui".contentEquals(root.getPackageName());
+            button = consuming ? findButton(root, point) : null;
+            down = point;
+            dragged = false;
+        }
+        if (!consuming) {
+            return false;
+        }
+        if (action == MotionEvent.ACTION_MOVE) {
+            int dx = point.getX() - down.getX();
+            int dy = point.getY() - down.getY();
+            dragged |= dx * dx + dy * dy > 24 * 24;
+        } else if (action == MotionEvent.ACTION_UP) {
+            if (!dragged && button != null && button.refresh() && button.isVisibleToUser() && button.isEnabled()) {
+                boolean clicked = button.performAction(AccessibilityNodeInfo.ACTION_CLICK);
+                Ln.d("TV button action: " + clicked);
+            }
+            button = null;
+            consuming = false;
+        } else if (action == MotionEvent.ACTION_CANCEL) {
+            button = null;
+            consuming = false;
+        }
+        return true;
+    }
+
+    synchronized boolean scroll(float hScroll, float vScroll) {
+        if (vScroll == 0 || Math.abs(hScroll) > Math.abs(vScroll)) {
+            return false;
+        }
+        long now = SystemClock.uptimeMillis();
+        if (lastWheelEvent == 0 || now - lastWheelEvent > 150) {
+            AccessibilityNodeInfo root = automation().getRootInActiveWindow();
+            wheelDesktop = root != null && "com.tcl.cyberui".contentEquals(root.getPackageName());
+            wheelAmount = 0;
+        }
+        lastWheelEvent = now;
+        if (!wheelDesktop) {
+            return false;
+        }
+        int key = vScroll < 0 ? KeyEvent.KEYCODE_DPAD_DOWN : KeyEvent.KEYCODE_DPAD_UP;
+        if (wheelKey != 0 && wheelKey != key) {
+            stopWheel();
+            lastWheelEvent = now;
+        }
+        if (wheelKey == 0) {
+            wheelAmount += vScroll;
+            if (Math.abs(wheelAmount) < 0.2f) {
+                return true;
+            }
+            wheelKey = wheelAmount < 0 ? KeyEvent.KEYCODE_DPAD_DOWN : KeyEvent.KEYCODE_DPAD_UP;
+            wheelRepeat = 0;
+            lastWheelKey = now;
+            Device.injectKeyEvent(KeyEvent.ACTION_DOWN, wheelKey, 0, 0, 0, Device.INJECT_MODE_ASYNC);
+            Ln.d("TV desktop wheel: down key=" + wheelKey);
+        } else if (now - lastWheelKey >= 80) {
+            lastWheelKey = now;
+            Device.injectKeyEvent(KeyEvent.ACTION_DOWN, wheelKey, ++wheelRepeat, 0, 0, Device.INJECT_MODE_ASYNC);
+            Ln.d("TV desktop wheel: repeat=" + wheelRepeat);
+        }
+        wheelHandler.removeCallbacks(wheelRelease);
+        wheelHandler.postDelayed(wheelRelease, 120);
+        return true;
+    }
+
+    synchronized void stopWheel() {
+        if (wheelHandler != null) {
+            wheelHandler.removeCallbacks(wheelRelease);
+        }
+        if (wheelKey != 0) {
+            Device.injectKeyEvent(KeyEvent.ACTION_UP, wheelKey, 0, 0, 0, Device.INJECT_MODE_ASYNC);
+            Ln.d("TV desktop wheel: up key=" + wheelKey);
+        }
+        wheelKey = 0;
+        wheelAmount = 0;
+        lastWheelEvent = 0;
+    }
+
+    void close() {
+        stopWheel();
+        if (automation != null) {
+            try {
+                UiAutomation.class.getMethod("disconnect").invoke(automation);
+            } catch (ReflectiveOperationException e) {
+                Ln.e("Cannot disconnect TV button controller", e);
+            }
+            thread.quitSafely();
+        }
+    }
+}
